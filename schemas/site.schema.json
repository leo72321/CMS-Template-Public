{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cms-template.local/site.schema.json",
  "title": "網站設定（中文提示）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "title",
    "description",
    "author",
    "media"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "description": "正式網域"
    },
    "title": {
      "type": "string",
      "description": "網站名稱"
    },
    "description": {
      "type": "string",
      "description": "網站簡介"
    },
    "author": {
      "type": "string",
      "description": "預設作者"
    },
    "language": {
      "type": "string",
      "description": "預設語言；目前支援繁中、英文、西班牙文",
      "enum": [
        "zh-TW",
        "en",
        "es"
      ]
    },
    "indexable": {
      "type": "boolean",
      "description": "是否開放搜尋引擎收錄，公版預設 false"
    },
    "productionBranch": {
      "type": "string",
      "description": "Cloudflare Pages 正式分支"
    },
    "gtmId": {
      "type": "string",
      "description": "GTM 容器 ID，留空不載入"
    },
    "pageSize": {
      "type": "integer",
      "description": "每頁文章數，1 到 50",
      "minimum": 1,
      "maximum": 50
    },
    "minArchiveItems": {
      "type": "integer",
      "description": "彙整頁最低可索引文章數，至少 2",
      "minimum": 2
    },
    "_說明": {
      "type": "string",
      "description": "中文註解，不影響功能"
    },
    "$schema": {
      "type": "string",
      "description": "編輯器欄位提示來源"
    },
    "media": {
      "type": "object",
      "description": "B2 圖床設定",
      "additionalProperties": false,
      "required": [
        "bucket"
      ],
      "properties": {
        "_說明": {
          "type": "string",
          "description": "中文註解"
        },
        "bucket": {
          "type": "string",
          "description": "B2 儲存桶名稱"
        },
        "cdnBase": {
          "type": "string",
          "description": "完整公開 CDN URL 前綴（含 https://，可有 /file/儲存桶/ 路徑）；實際圖片網址另接網站網域與物件路徑。不是 S3 Endpoint。"
        }
      }
    },
    "blogIndexable": {
      "type": "boolean",
      "description": "是否允許 /blog/ 文章總覽被搜尋引擎收錄（仍受全站開關限制）"
    },
    "storage": {
      "type": "object",
      "description": "S3 相容圖床供應商。由 GitHub Actions 圖床設定精靈選單自動設定。金鑰只放 Secrets。",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpoint",
        "region"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "b2",
            "r2",
            "aws-s3",
            "wasabi",
            "digitalocean",
            "hetzner",
            "scaleway",
            "akamai",
            "other-s3"
          ],
          "description": "Backblaze B2、Cloudflare R2、AWS S3、Wasabi、DigitalOcean Spaces、Hetzner、Scaleway、Akamai/Linode、其他 S3"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "S3 API 完整 HTTPS 根網址，不能填 CDN 網址"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "S3 Region；Cloudflare R2 使用 auto"
        }
      }
    },
    "blogLegacyPaths": {
      "type": "array",
      "description": "舊文章分類誤作 Blog 入口的歷史網址（僅保留 301，例如 /insights/），不影響真正分類；不須改文章 canonical",
      "items": {
        "type": "string",
        "pattern": "^/[^/?# ]+/$"
      },
      "uniqueItems": true
    },
    "relatedArticles": {
      "type": "object",
      "description": "文章底部自動推薦。計算時扣除正文已連結的文章，最多 12 篇",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "是否顯示文章底部自動延伸閱讀"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "每篇文章站內推薦總名額（包含正文已連結的文章），預設 4"
        }
      }
    },
    "postFooter": {
      "type": "object",
      "description": "全站 POST 頁尾設定：標籤、作者、可個別開關的自訂區塊；延伸閱讀仍由 relatedArticles.enabled 控制。",
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "boolean",
          "description": "是否在所有 POST 顯示文章標籤"
        },
        "author": {
          "type": "object",
          "description": "全站作者介紹卡，可關閉顯示；page 指定既有 PAGE 網址。",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "bio": {
              "type": "string"
            },
            "photo": {
              "type": "string"
            },
            "page": {
              "type": "string",
              "description": "站內 PAGE 路徑，例如 /about/"
            },
            "linkText": {
              "type": "string"
            }
          }
        },
        "blocks": {
          "type": "array",
          "description": "每個區塊獨立 enabled 開關，停用不會刪除內容；全部 POST 共用。",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "title": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "description": "站內 PAGE 或外部 HTTPS"
              },
              "linkText": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "redirectManagement": {
      "type": "object",
      "description": "Cloudflare Pages 永久轉址容量防呆；1500、1800、1950 各提醒一次，1950 後每新增一條提醒。依建立日期自動淘汰，非以最後存取日期判定。",
      "additionalProperties": false,
      "properties": {
        "maxActive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "description": "最多實際輸出幾條 301；預設 1950，超過按建立日期最舊者淘汰"
        },
        "overflowAutoPrune": {
          "type": "boolean",
          "description": "超過 maxActive 時自動淘汰最舊的轉址，預設 true；關閉則直接拒絕超限建置"
        },
        "agePrune": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "依首次記錄建立日期的天數清理；預設不啟動。不是「XX 天未被訪問」。"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 36500,
              "description": "首次記錄後超過幾天清除；預設 90"
            }
          }
        }
      }
    },
    "sitemap": {
      "type": "object",
      "description": "XML Sitemap 總索引與分類自動分片；預設每份 200 個 URL，可自行調整。每份法定上限 50,000 URL／50 MiB。",
      "additionalProperties": false,
      "properties": {
        "maxUrls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000,
          "description": "每份 XML Sitemap 最多包含的 URL 數；預設 200。不影響前台文章分頁 pageSize。"
        }
      }
    },
    "contentTypes": {
      "type": "array",
      "maxItems": 30,
      "description": "自訂文章類型 CPT，cars / houses / products 等，獨立於 Blog；詳見 docs/CPT自訂內容.md",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,39}$",
            "description": "不可更改的類型代碼，例如 cars"
          },
          "name": {
            "type": "string",
            "description": "類型名稱"
          },
          "description": {
            "type": "string"
          },
          "indexable": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,39}$"
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "number",
                    "price",
                    "boolean",
                    "select",
                    "date",
                    "url",
                    "image",
                    "gallery",
                    "file"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "showOnList": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "可選多語言功能；預設關閉，既有網站不改網址",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "關閉時不載入多語言路由或提示"
        },
        "defaultLocale": {
          "type": "string",
          "enum": [
            "zh-TW",
            "en",
            "es"
          ],
          "description": "保留原本沒有語言前綴的預設語言"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "zh-TW",
              "en",
              "es"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "description": "已啟用的語言列表"
        },
        "languageSuggestion": {
          "type": "boolean",
          "default": true,
          "description": "語言不一致且譯文存在時，提示使用者自行切換"
        },
        "metadata": {
          "type": "object",
          "description": "各語言品牌首頁 SEO 資訊（選填）：en、es 等；未指定時沿用預設語言",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
