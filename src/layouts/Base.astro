---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { languageEnabled } from '../lib/i18n';
import { gtmInlineCode } from '../lib/gtm';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Model, Route } from '../lib/model';
interface Props { model: Model; route: Route; }
const { model, route } = Astro.props;
const gtm = model.site.gtmId;
const gtmCode = gtmInlineCode(gtm);
---
<!doctype html>
<html lang={route.locale ?? model.site.language}>
  <head><SEO route={route} site={model.site} />{gtm && <script is:inline set:html={gtmCode} />}</head>
  <body>
    {gtm && <noscript><iframe title="Google 代碼管理工具" src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <a class="skip-link" href="#main">跳至主要內容</a>
    <div class="shell"><Header model={model} route={route} />
      {languageEnabled(model.site) && <LanguageSwitcher model={model} route={route} />}<main id="main" tabindex="-1"><slot /></main><Footer site={model.site} route={route} /></div>
  </body>
</html>
