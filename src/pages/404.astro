---
import { getModel } from '../lib/content';
import { localePrefix, t } from '../lib/i18n';
import Base from '../layouts/Base.astro';
const model = await getModel();
const locale = model.site.i18n.enabled ? model.site.i18n.defaultLocale : model.site.language;
const prefix = localePrefix(locale, model.site);
const title = t(locale, 'notFound', {}, model.site);
const description = t(locale, 'notFoundDescription', {}, model.site);
---
<Base model={model} route={{ path: '/404/', kind: 'page', title, description, noindex: true }}><section class="hero"><p class="eyebrow">404</p><h1>{title}</h1><p>{description}</p><a class="text-link" href={prefix + "/blog/"}>{t(locale, 'browse', {}, model.site)} ↗</a></section></Base>
