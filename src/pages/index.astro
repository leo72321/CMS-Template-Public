---
import { localePrefix, t } from "../lib/i18n";
import { getModel } from '../lib/content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
const model = await getModel();
const route = model.byPath.get('/')!;
const locale = model.site.i18n.enabled ? model.site.i18n.defaultLocale : model.site.language;
const prefix = localePrefix(locale, model.site);
const categories = model.categories.filter(c => model.posts.some(p => p.data.category === c.id));
---
<Base model={model} route={route}>
  <section class="hero"><p class="eyebrow">{t(locale, "subjects", {}, model.site)}</p><h1>{model.site.title}</h1><p class="hero-description">{model.site.description}</p><a class="text-link" href={prefix + "/blog/"}>{t(locale, "browse", {}, model.site)} <span aria-hidden="true">↗</span></a></section>
  <section class="section"><div class="section-heading"><h2>{t(locale, "newest", {}, model.site)}</h2><span>{t(locale, "postCount", { count: model.posts.length.toString().padStart(2, '0') }, model.site)}</span></div><PostList site={model.site} posts={model.posts.slice(0, 6)} categories={model.categories} locale={locale} prefix={prefix} />{!model.posts.length && <p class="empty">{t(locale, "empty", {}, model.site)}</p>}</section>
  {categories.length > 0 && <section class="section"><div class="section-heading"><h2>{t(locale, "subjects", {}, model.site)}</h2></div><div class="category-list">{categories.map(c => <a href={`${prefix}/${c.slug}/`}><strong>{c.name}</strong><span>{c.description}</span><span aria-hidden="true">↗</span></a>)}</div></section>}
</Base>
