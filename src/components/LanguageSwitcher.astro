---
import type { Model, Route } from '../lib/model';
import { localeNames, t } from '../lib/i18n';
interface Props { model: Model; route: Route; }
const { model, route } = Astro.props;
const site = model.site;
const current = route.locale ?? site.language;
// Never offer translations that are not actually published.
const choices = Object.entries(route.alternates ?? {}).filter(([, path]) => model.byPath.has(path));
const suggest = site.i18n.enabled && site.i18n.languageSuggestion && choices.length > 1;
---
{choices.length > 1 && <div class="language-bar" aria-label="Language">
  <nav class="language-choices" aria-label="Language selection">
    {choices.map(([lang, path]) => <a href={path} hreflang={lang} lang={lang} data-locale-link={lang} aria-current={lang === current ? 'page' : undefined}>{localeNames[lang] ?? lang}</a>)}
  </nav>
  {suggest && <aside class="language-suggestion" id="language-suggestion" hidden data-current={current} data-prompt={t(current, 'languagePrompt')} data-switch={t(current, 'switch')} data-stay={t(current, 'stay')}>
    <p id="language-suggestion-message"></p>
    <div><a id="language-suggestion-action" href="#"></a><button id="language-suggestion-dismiss" type="button">{t(current, 'stay')}</button></div>
  </aside>}
</div>}
{suggest && <script is:inline>
(() => {
  const prompt = document.getElementById('language-suggestion');
  if (!prompt) return;
  const current = prompt.dataset.current;
  const links = new Map([...document.querySelectorAll('[data-locale-link]')].map(a => [a.dataset.localeLink, a]));
  const saved = (() => { try { return localStorage.getItem('cms:locale-preference:v1'); } catch { return null; } })();
  // A preference is explicit. A direct link in a different language must never be overridden.
  if (saved) return;
  const preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
    .map(x => x.toLowerCase()).map(x => [...links.keys()].find(lang => lang.toLowerCase() === x) ??
      [...links.keys()].find(lang => x.startsWith(lang.toLowerCase().split('-')[0] + '-') || x === lang.toLowerCase().split('-')[0]))
    .find(Boolean);
  if (!preferred || preferred === current) return;
  const link = links.get(preferred);
  if (!link) return;
  const name = link.textContent.trim();
  prompt.querySelector('#language-suggestion-message').textContent = prompt.dataset.prompt.replace('{language}', name);
  const go = prompt.querySelector('#language-suggestion-action');
  go.textContent = prompt.dataset.switch.replace('{language}', name);
  go.href = link.href;
  const save = lang => { try { localStorage.setItem('cms:locale-preference:v1', lang); } catch {} };
  go.addEventListener('click', () => save(preferred));
  prompt.querySelector('#language-suggestion-dismiss').addEventListener('click', () => {
    save(current); prompt.hidden = true;
  });
  document.querySelectorAll('[data-locale-link]').forEach(a => a.addEventListener('click', () => save(a.dataset.localeLink)));
  prompt.hidden = false;
})();
</script>}
<style>
.language-bar{padding:12px 0;border-bottom:1px solid var(--line)}
.language-choices{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem}
.language-choices a[aria-current=page]{font-weight:750;text-decoration:underline}
.language-suggestion{padding:12px 16px;margin-top:12px;border:1px solid var(--line);border-radius:8px;font-size:.84rem;background:var(--paper)}
.language-suggestion[hidden]{display:none}
.language-suggestion p{margin:0 0 10px}
.language-suggestion>div{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.language-suggestion button{border:1px solid var(--line);border-radius:6px;background:transparent;padding:6px 10px;cursor:pointer}
.language-suggestion a{font-weight:700}
</style>
