---
import type { Model, Route } from '../lib/model';
import { localeDisplayName, localePrefix, t } from '../lib/i18n';
interface Props { model: Model; route: Route; }
const { model, route } = Astro.props;
const site = model.site;
const current = route.locale ?? site.language;
// Never offer translations that are not actually published.
const choices = site.i18n.locales.map(lang => [lang, route.alternates?.[lang] ?? localePrefix(lang, site) + '/'] as const).filter(([,path]) => model.byPath.has(path));
const suggest = site.i18n.enabled && site.i18n.languageSuggestion && Object.keys(route.alternates ?? {}).length > 1;
---
{choices.length > 1 && <div class="language-bar" aria-label="Language">
  <nav class="language-choices" aria-label="Language selection">
    {choices.map(([lang, path]) => <a href={path} hreflang={route.alternates?.[lang] ? lang : undefined} lang={lang} data-locale-link={lang} data-exact={route.alternates?.[lang] ? "1" : "0"} aria-current={lang === current ? 'page' : undefined}>{localeDisplayName(lang, site)}</a>)}
  </nav>
  {suggest && <aside class="language-suggestion" id="language-suggestion" hidden data-current={current} data-prompt={t(current, 'languagePrompt', {}, site)} data-switch={t(current, 'switch', {}, site)} data-stay={t(current, 'stay', {}, site)}>
    <p id="language-suggestion-message"></p>
    <div><a id="language-suggestion-action" href="#"></a><button id="language-suggestion-dismiss" type="button">{t(current, 'stay', {}, site)}</button></div>
  </aside>}
</div>}
{site.i18n.enabled && site.i18n.languageSuggestion && choices.length > 1 && <script is:inline>
(() => {
  const links = new Map([...document.querySelectorAll('[data-locale-link]')].map(a => [a.dataset.localeLink, a]));
  if (links.size < 2) return;
  const storageKey = 'cms:locale-preference:v1';
  const save = locale => { try { localStorage.setItem(storageKey, locale); } catch { /* private mode */ } };
  // Save manually chosen languages on EVERY page, even after a preference was saved.
  for (const [locale, link] of links) link.addEventListener('click', () => save(locale));
  const prompt = document.getElementById('language-suggestion');
  if (!prompt) return;
  let saved = null;
  try { saved = localStorage.getItem(storageKey); } catch { /* storage blocked */ }
  if (saved && links.has(saved)) return;

  const current = prompt.dataset.current;
  const available = [...links.keys()];
  function matchLanguage(browserTag) {
    const requested = browserTag.toLowerCase();
    const exact = available.find(x => x.toLowerCase() === requested);
    if (exact) return exact;
    const primary = requested.split('-')[0];
    const candidates = available.filter(x => x.toLowerCase().split('-')[0] === primary);
    // en-US and en-GB are distinct options. Do not guess a region.
    return candidates.length === 1 ? candidates[0] : null;
  }
  const preferences = navigator.languages?.length ? navigator.languages : [navigator.language];
  const preferred = preferences.map(matchLanguage).find(Boolean);
  if (!preferred || preferred === current) return;
  const link = links.get(preferred);
  // Only offer same-page translations, not a misleading redirect to another homepage.
  if (!link || link.dataset.exact !== '1') return;

  const name = link.textContent.trim();
  prompt.querySelector('#language-suggestion-message').textContent = prompt.dataset.prompt.replace('{language}', name);
  const go = prompt.querySelector('#language-suggestion-action');
  go.textContent = prompt.dataset.switch.replace('{language}', name);
  go.href = link.href;
  prompt.querySelector('#language-suggestion-dismiss').addEventListener('click', () => {
    save(current);
    prompt.hidden = true;
  });
  prompt.hidden = false;
})();
</script>}
<style>
.language-bar{padding:12px 0;border-bottom:1px solid var(--line)}
.language-choices{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem}
.language-choices a[aria-current=page]{font-weight:750;text-decoration:underline}
.language-suggestion{padding:12px 16px;margin-top:12px;border:1px solid var(--line);border-radius:8px;font-size:.84rem;background:var(--paper)}
.language-suggestion[hidden]{display:none}
.language-suggestion p{margin:0 0 10px}
.language-suggestion>div{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.language-suggestion button{border:1px solid var(--line);border-radius:6px;background:transparent;padding:6px 10px;cursor:pointer}
.language-suggestion a{font-weight:700}
</style>
