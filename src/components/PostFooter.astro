---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { pathFor, type Model, type Post } from '../lib/model';
import PostList from './PostList.astro';
import PostFooterCustom from './PostFooterCustom.astro';
interface Props { model: Model; post: Post; locale?: string; }
const { model, post, locale = model.site.language } = Astro.props;
import { localePrefix, t } from '../lib/i18n';
const prefix = localePrefix(locale, model.site);
const categories = ('localizedCategories' in model ? (model.localizedCategories as Map<string, typeof model.categories>).get(locale) : model.categories) ?? model.categories;
const tags = ('localizedTags' in model ? (model.localizedTags as Map<string, typeof model.tags>).get(locale) : model.tags) ?? model.tags;
const posts = ('localizedPosts' in model ? (model.localizedPosts as Map<string, typeof model.posts>).get(locale) : model.posts) ?? model.posts;
const { postFooter, relatedArticles } = model.site;
// 每篇 POST 個別計算推薦；正文已出現的站內文章先排除，避免重複。
// Inspect only actual outbound links. Avoid scanning the full article body against every post.
const hrefs = new Set<string>();
for (const match of post.body.matchAll(/(?:\]\(|href\s*=\s*["'])(\/?[^\s"'?#)]+)(?:[?#][^\s"')]+)?/g)) {
  try {
    const raw = match[1];
    const url = new URL(raw, 'https://' + model.site.domain);
    if (url.hostname === model.site.domain) hrefs.add(decodeURIComponent(url.pathname));
  } catch { /* invalid links are reported by the existing audit */ }
}
const uidByPath = new Map<string, string>();
for (const candidate of posts) {
  const uid = candidate.data.uid;
  uidByPath.set(prefix + pathFor(candidate, categories), uid);
  uidByPath.set(prefix + '/blog/' + candidate.data.slug + '/', uid);
  for (const base of model.site.blogLegacyPaths) uidByPath.set(prefix + base + candidate.data.slug + '/', uid);
}
const referenced = new Set([...hrefs].map(p => uidByPath.get(p)).filter((uid): uid is string => !!uid));
const remaining = Math.max(0, relatedArticles.maxItems - referenced.size);
const related = relatedArticles.enabled && remaining > 0 ? model.related(post, remaining, referenced) : [];
const blocks = postFooter.blocks.filter(b => b.enabled && (b.title || b.text || b.href));
const author = postFooter.author;
const authorName = author.name || model.site.author;
const photo = author.photo;
const photoAvailable = !!photo && (photo.startsWith('https://') || (photo.startsWith('/') && existsSync(join(process.cwd(), 'public', photo.slice(1)))));
const showTags = postFooter.tags && post.data.tags.length > 0;
const hasFooter = showTags || author.enabled || blocks.length > 0 || related.length > 0;
---
{hasFooter && <div class="post-footer" aria-label="文章下方資訊">
  {showTags && <nav class="post-footer-tags" aria-label="文章標籤">
    {post.data.tags.map(id => tags.find(t => t.id === id)).filter((tag): tag is (typeof model.tags)[number] => !!tag).map(tag => <a href={prefix + '/tag/' + tag.slug + '/'}>#{tag.name}</a>)}
  </nav>}
  {author.enabled && <section class="post-footer-author" aria-label="作者介紹">
    {photoAvailable && <img src={photo} alt={authorName + '照片'} loading="lazy" decoding="async" width="88" height="88" />}
    <div class="post-footer-author-body">
      <strong>{authorName}</strong>{author.role && <span class="post-footer-role">・{author.role}</span>}
      {author.bio && <p>{author.bio}</p>}
      {author.page && <a class="post-footer-author-link" href={author.page}>{author.linkText} →</a>}
    </div>
  </section>}
  {blocks.map(block => <PostFooterCustom block={block} />)}
  {related.length > 0 && <section class="post-footer-related" aria-label="延伸閱讀">
    <h2>{t(locale, "related")}</h2>
    <PostList posts={related} categories={categories} prefix={prefix} locale={locale} />
  </section>}
</div>}
<style>
  .post-footer{max-width:100%;margin:34px 0 0}
  .post-footer>*{margin-top:26px;padding-top:20px;border-top:1px solid #dce2d8}
  .post-footer-tags{display:flex;flex-wrap:wrap;gap:8px}
  .post-footer-tags a{border:1px solid #dce2d8;border-radius:99px;padding:4px 11px;font-size:.8rem;text-decoration:none}
  .post-footer-author{display:flex;align-items:flex-start;gap:18px}
  .post-footer-author img{flex:0 0 88px;width:88px;height:88px;object-fit:cover;border-radius:8px}
  .post-footer-author-body{min-width:0}
  .post-footer-role{font-size:.85rem;color:#667268}
  .post-footer-author p{font-size:.9rem;line-height:1.75;margin:8px 0}
  .post-footer-author-link{font-size:.88rem}
  .post-footer-related h2{font-size:1.27rem;line-height:1.4;margin:0 0 15px}
</style>
