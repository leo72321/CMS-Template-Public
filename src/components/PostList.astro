---
import { postPath, type Post } from '../lib/model';
import type { Taxonomy } from '../lib/schema';
interface Props { posts: Post[]; categories: Taxonomy[]; }
const { posts, categories } = Astro.props;
---
<div class="post-list">{posts.map(post => <article class="post-card">
  <div class="meta"><time datetime={post.data.publishedAt}>{post.data.publishedAt}</time><span>{categories.find(c => c.id === post.data.category)?.name}</span>{post.data.sample && <span>範例</span>}</div>
  <h2><a href={postPath(post, categories)}>{post.data.title}<span aria-hidden="true">↗</span></a></h2>
  <p>{post.data.description}</p>
</article>)}</div>
