---
import type { Model } from '../lib/model';
interface Props { model: Model; }
const { model } = Astro.props;
const pathname = Astro.url.pathname;
const current = (href: string) => pathname === href ? 'page' : undefined;
const primaryPages = model.pages.filter(p => model.site.headerNavPages.includes(p.data.slug));
---
<header class="site-header">
  <a class="brand" href="/" aria-current={current("/")}>{model.site.title}<span class="brand-dot" aria-hidden="true"></span></a>
  <nav aria-label="主要導覽"><a href="/blog/" aria-current={current("/blog/")}>全部文章</a>{model.site.contentTypes.map(t => <a href={'/' + t.id + '/'} aria-current={current('/' + t.id + '/')}>{t.name}</a>)}{primaryPages.map(p => <a href={`/${p.data.slug}/`} aria-current={current(`/${p.data.slug}/`)}>{p.data.title}</a>)}</nav>
</header>
