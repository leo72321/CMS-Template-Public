---
import { localePrefix, t } from '../lib/i18n';
import type { Model, Route } from '../lib/model';
interface Props { model: Model; route: Route; }
const { model, route } = Astro.props;
const locale = route.locale ?? model.site.language;
const prefix = localePrefix(locale, model.site);
const pages = ('localizedPages' in model ? (model.localizedPages as Map<string, typeof model.pages>).get(locale) : model.pages) ?? model.pages;
const types = model.site.contentTypes;
const pathname = Astro.url.pathname;
const current = (href: string) => pathname === href ? 'page' : undefined;
const primaryPages = pages.filter(p => model.site.headerNavPages.includes(p.data.slug));
---
<header class="site-header">
  <a class="brand" href={prefix + "/"} aria-current={current(prefix + "/")}>{model.site.title}<span class="brand-dot" aria-hidden="true"></span></a>
  <nav aria-label="主要導覽"><a href={prefix + "/blog/"} aria-current={current(prefix + "/blog/")}>{t(locale, "blog")}</a>{types.map(t => <a href={prefix + '/' + t.id + '/'} aria-current={current(prefix + '/' + t.id + '/')}>{t.name}</a>)}{primaryPages.map(p => <a href={`${prefix}/${p.data.slug}/`} aria-current={current(`${prefix}/${p.data.slug}/`)}>{p.data.title}</a>)}</nav>
</header>
