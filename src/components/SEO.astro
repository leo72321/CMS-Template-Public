---
import { encodePath, type Route } from '../lib/model';
import type { Site } from '../lib/schema';
interface Props { route: Route; site: Site; }
const { route, site } = Astro.props;
const locale = route.locale ?? site.language;
const canonical = `https://${site.domain}${encodePath(route.path)}`;
const siteTitle = route.siteTitle ?? site.title;
const title = route.kind === 'home' ? siteTitle : `${route.title}｜${siteTitle}`;
const cover = route.document?.data.cover;
const image = cover ? new URL(cover.ogUrl ?? cover.url, `https://${site.domain}`).href : undefined;
const document = route.document;
const schema = document?.kind === 'post' || document?.kind === 'cpt' ? {
  '@context': 'https://schema.org', '@type': document.kind === 'post' ? 'BlogPosting' : 'Article', headline: document.data.title,
  description: document.data.description, url: canonical, mainEntityOfPage: canonical,
  ...(document.data.publishedAt ? { datePublished: `${document.data.publishedAt}T00:00:00+08:00`, dateModified: `${document.data.updatedAt ?? document.data.publishedAt}T00:00:00+08:00` } : {}),
  author: { '@type': 'Person', name: site.author }, publisher: { '@type': 'Organization', name: siteTitle },
  ...(image ? { image: [image] } : {}),
} : {
  '@context': 'https://schema.org', '@type': route.kind === 'category' || route.kind === 'tag' || route.kind === 'blog' || route.kind === 'cpt-index' ? 'CollectionPage' : 'WebPage',
  name: route.title, description: route.description, url: canonical,
};
// 轉義 < 防止文章標題意外結束 JSON-LD 的 script 標籤。
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={route.description} />
<meta name="robots" content={route.noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content={locale.replace("-", "_")} />
{route.alternates && !route.noindex && Object.entries(route.alternates).map(([lang,path]) => <link rel="alternate" hreflang={lang} href={`https://${site.domain}${encodePath(path)}`} />)}
{route.alternates && !route.noindex && route.alternates[site.i18n.defaultLocale] && <link rel="alternate" hreflang="x-default" href={`https://${site.domain}${encodePath(route.alternates[site.i18n.defaultLocale])}`} />}

<meta property="og:type" content={route.kind === 'post' || route.kind === 'cpt' ? 'article' : 'website'} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:title" content={title} />
<meta property="og:description" content={route.description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{image && <><meta property="og:image" content={image} /><meta property="og:image:alt" content={cover!.alt} /><meta name="twitter:image" content={image} /></>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline type="application/ld+json" set:html={json(schema)} />
